{
  "openapi": "3.0.0",
  "info": {
    "title": "Project Resource Management API",
    "version": "1.0.0",
    "description": "APIs for managing project-level resources such as run properties and string encryption. Access is restricted to users authorized for the specified project."
  },
  "servers": [
    {
      "url": "{accelqLoginUrl}/awb/api/2.0/{tenantCode}/{projectCode}",
      "variables": {
        "accelqLoginUrl": {
          "default": "https://org.accelq.io",
          "description": "The AccelQ login URL for API access."
        },
        "tenantCode": {
          "default": "TenantCode",
          "description": "Tenant code for identifying the organization."
        },
        "projectCode": {
          "default": "ProjectCode",
          "description": "Project Code found under Auth properties of ACCELQ User Profile"
        }
      }
    }
  ],
   "components": {
    "securitySchemes": {
      "UserId": {
        "type": "apiKey",
        "in": "header",
        "name": "user_id",
        "description": "Login Email."
      },
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "api_key",
        "description": "API Key found under Auth Properties in ACCELQ User Profile."
      }
    }
  },
  "security": [
    {
      "UserId": [],
      "ApiKey": []
    }
  ],
  "paths": {
    "/res/run-property": {
      "get": {
        "tags": [
          "Run Properties"
        ],
        "summary": "List Run Properties",
        "description": "Returns a paginated list of run properties configured for the current project.",
        "operationId": "getAllRunProperties",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number for pagination.",
            "schema": {
              "type": "integer",
              "default": 1,
              "example": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "Number of items per page (Maximum: 100).",
            "schema": {
              "type": "integer",
              "default": 20,
              "example": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with a list of Run Properties.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "page": {
                      "type": "integer",
                      "example": 3
                    },
                    "pageSize": {
                      "type": "integer",
                      "example": 10
                    },
                    "totalPages": {
                      "type": "integer",
                      "example": 4
                    },
                    "totalCount": {
                      "type": "integer",
                      "example": 36
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "pid": {
                            "type": "integer",
                            "example": 14885
                          },
                          "name": {
                            "type": "string",
                            "example": "Test"
                          },
                          "createdUser": {
                            "type": "integer",
                            "example": 2
                          },
                          "createdTimestamp": {
                            "type": "number",
                            "example": 1730801799833
                          },
                          "lastModifiedUser": {
                            "type": "integer",
                            "example": 5
                          },
                          "lastModifiedTimestamp": {
                            "type": "integer",
                            "example": 1746801799833
                          }
                        }
                      },
                      "example": [
                        {
                          "pid": 1,
                          "name": "City",
                          "createdUser": 1,
                          "createdTimeStamp": 1730801799833,
                          "lastModifiedUser": 1,
                          "lastModifiedTimestamp": 1730801799833
                        },
                        {
                          "pid": 2,
                          "name": "Price",
                          "createdUser": 1,
                          "createdTimeStamp": 1730801799833,
                          "lastModifiedUser": 1,
                          "lastModifiedTimestamp": 1730805955710
                        },
                        {
                          "pid": 3,
                          "name": "Date",
                          "createdUser": 1,
                          "createdTimeStamp": 1730801799833,
                          "lastModifiedUser": 1,
                          "lastModifiedTimestamp": 1730801799833
                        },
                        {
                          "pid": 4,
                          "name": "Booking Id",
                          "createdUser": 1,
                          "createdTimeStamp": 1730801799833,
                          "lastModifiedUser": 1,
                          "lastModifiedTimestamp": 1730805955710
                        },
                        {
                          "pid": 5,
                          "name": "Movie Name",
                          "createdUser": 1,
                          "createdTimeStamp": 1730801799833,
                          "lastModifiedUser": 1,
                          "lastModifiedTimestamp": 1730805955710
                        },
                        {
                          "pid": 6,
                          "name": "Total Centuries",
                          "createdUser": 1,
                          "createdTimeStamp": 1730801799833,
                          "lastModifiedUser": 1,
                          "lastModifiedTimestamp": 1730805955710
                        },
                        {
                          "pid": 7,
                          "name": "Country",
                          "createdUser": 1,
                          "createdTimeStamp": 1730801799833,
                          "lastModifiedUser": 1,
                          "lastModifiedTimestamp": 1730805955710
                        },
                        {
                          "pid": 8,
                          "name": "Is Admin",
                          "createdUser": 1,
                          "createdTimeStamp": 1730801799833,
                          "lastModifiedUser": 1,
                          "lastModifiedTimestamp": 1730801799833
                        },
                        {
                          "pid": 9,
                          "name": "Mobile Type",
                          "createdUser": 1,
                          "createdTimeStamp": 1730801799833,
                          "lastModifiedUser": 1,
                          "lastModifiedTimestamp": 1730805955710
                        },
                        {
                          "pid": 10,
                          "name": "Discount Percentage",
                          "createdUser": 1,
                          "createdTimeStamp": 1730801799833,
                          "lastModifiedUser": 1,
                          "lastModifiedTimestamp": 1730801799833
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid page number or page size",
            "content": {
              "application/json": {
                "schema": {},
                "examples": {
                  "invalidPage": {
                    "summary": "Page number too high",
                    "value": {
                      "error": "Requested page exceeds available pages."
                    }
                  },
                  "invalidSize": {
                    "summary": "Page size out of range",
                    "value": {
                      "error": "Page size must be between 1 and 100."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - User does not have permission to fetch Run Properties",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "User do not have authorization to access this feature."
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Project not found.",
            "content": {
              "application/json": {
                "schema": {},
                "example": {
                  "error": "Project with code 'proj123' not found."
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Run Properties"
        ],
        "summary": "Create Run Property",
        "description": "Creates a new run property for the specified project.",
        "operationId": "createRunProperty",
        "parameters": [
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "example": "New Run Property",
                    "description": "Name of the new Run Property.<Br/> Name validation rules: Can contain only letters, numbers, spaces, periods, and underscores."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Run Property successfully created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "pid": {
                      "type": "integer",
                      "example": 15754
                    },
                    "name": {
                      "type": "string",
                      "example": "New Run Property"
                    },
                    "createdUser": {
                      "type": "integer",
                      "example": 2
                    },
                    "createdTimestamp": {
                      "type": "number",
                      "example": 1730801799833
                    },
                    "lastModifiedUser":{
                      "type":"number",
                      "example":2
                    },
                    "lastModifiedTimestamp":{
                      "type": "number",
                      "example": 1730801799833
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request. Validation errors occurred.",
            "content": {
              "application/json": {
                "schema": {},
                "examples": {
                  "emptyName": {
                    "summary": "Name required",
                    "value": {
                      "error": "Run Property name is required."
                    }
                  },
                  "duplicateName": {
                    "summary": "Name already exists",
                    "value": {
                      "error": "Run Property with name 'New Run Property' already exists."
                    }
                  },
                  "nameValidation": {
                    "summary": "Name Validation error",
                    "value": {
                      "error": "Run Property  Can contain only letters, numbers, spaces, periods, and underscores."
                    }
                  },
                   "limitReached": {
                      "summary": "Max Run Property limit reached",
                      "value": {
                        "error": "Maximum Run Property limit of 500 reached. Unable to create additional Run Properties."
                      }
                    }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - User does not have permission to create Run Property.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "User do not have authorization to access this feature."
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Project not found.",
            "content": {
              "application/json": {
                "schema": {},
                "example": {
                  "error": "Project with code 'proj123' not found."
                }
              }
            }
          }
        }
      }
    },
    "/res/run-property/{runPropertyPid}": {
      "put": {
        "tags": [
          "Run Properties"
        ],
        "summary": "Update Run Property",
        "description": "Updates the name of an existing run property identified by its PID.",
        "operationId": "updateRunProperty",
        "parameters": [
          {
            "name": "runPropertyPid",
            "in": "path",
            "required": true,
            "description": "Run Property pid for which to update the name.",
            "schema": {
              "type": "integer",
              "example": "43"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "example": "New Run Property",
                    "description": "Name of the new Run Property.<Br/> Name validation rules: Can contain only letters, numbers, spaces, periods, and underscores."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Run Property successfully created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "pid": {
                      "type": "integer",
                      "example": 15754
                    },
                    "name": {
                      "type": "string",
                      "example": "New Run Property"
                    },
                    "createdUser": {
                      "type": "integer",
                      "example": 2
                    },
                    "createdTimestamp": {
                      "type": "number",
                      "example": 1730801799833
                    },
                    "lastModifiedUser": {
                      "type": "integer",
                      "example": 5
                    },
                    "lastModifiedTimestamp": {
                      "type": "integer",
                      "example": 1746801799833
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request. Validation errors occurred.",
            "content": {
              "application/json": {
                "schema": {},
                "examples": {
                  "emptyName": {
                    "summary": "Name required",
                    "value": {
                      "error": "Run Property name is required."
                    }
                  },
                  "duplicateName": {
                    "summary": "Name already exists",
                    "value": {
                      "error": "Run Property with name 'New Run Property' already exists."
                    }
                  },
                  "nameValidation": {
                    "summary": "Name Validation error",
                    "value": {
                      "error": "Run Property  Can contain only letters, numbers, spaces, periods, and underscores."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - User does not have permission to create Run Property.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "User do not have authorization to access this feature."
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Project not found.",
            "content": {
              "application/json": {
                "schema": {},
                "example": {
                  "error": "Project with code 'proj123' not found."
                }
              }
            }
          }
        }
      }
    },
    "/res/encrypt": {
      "get": {
        "tags": [
          "Encryption"
        ],
        "summary": "Encrypt string.",
        "description": "Encrypts the provided input string and returns the encrypted value.",
        "operationId": "encryptString",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "string",
                "example": "Input string",
                "description": "Input string (required)"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response with encrypted string.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "3kXu75r/kx3bCzjSVHsvcw=="
                }
              }
            }
          },
          "400": {
            "description": "Bad Request. Validation errors occurred.",
            "content": {
              "application/json": {
                "schema": {},
                "examples": {
                  "emptyString": {
                    "summary": "Name required",
                    "value": {
                      "error": "Input string is required."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - User does not have permission to encrypt string.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "User do not have authorization to access this feature."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/res/activity-logs": {
      "post": {
        "tags": ["Activity Logs"],
        "summary": "Fetch Scenario and Action Activity History",
        "description": "Fetches the activity history of Scenarios and Actions in a project using a stateless cursor-based approach. Designed for clients who need to track every create, update and delete operation on Scenarios and Actions, without missing or duplicating records.\n\n### Call patterns\n\n**Initial call (no `cursor`)**\n\nOmit the `cursor` field and supply the filters. `activityAfter`, `activityBefore`, `entityTypes` and `activityTypes` are required. The server returns the first page of activity within the date range and freezes the filters into an opaque cursor token returned as `nextCursor`.\n\n**Subsequent calls (with `cursor`)**\n\nPass only the `cursor` field from the previous response's `nextCursor`. Do not include any filters or dates; they are already frozen inside the cursor. To change filters, make a fresh initial call without a cursor.\n\n### Polling\n\n- `hasMore: true` — a full page was returned. Call again immediately with `nextCursor` to retrieve the next page.\n- `hasMore: false` — all matching activity has been delivered.\n- **Retrieving newer activity** — activity recorded after the initial call is not included in the current cursor. Make a fresh initial call with `activityAfter` set to the `activityTime` of the most recent record received.\n\n### Request fields\n\n- **`actorEmails`** *(optional)* — list of email addresses of the users whose activity is to be retrieved. Matching is case-insensitive. If omitted, empty or `null`, activity of all users is returned. Email addresses that do not match any user return no records.\n- **`entityTypes`** *(required)* — list of entity types to include. Supported values: `ACTION`, `AUTO_SCENARIO`, `MANUAL_SCENARIO`.\n- **`activityTypes`** *(required)* — list of activity types to include. Supported values: `CREATE`, `UPDATE`, `DELETE`. Check-in, check-out and changes to parts of an entity, such as input parameters or test cases, are reported as `UPDATE`.\n- **`activityAfter`** *(required)* — start of the time range (inclusive). Refer to the **Date rules** section.\n- **`activityBefore`** *(required)* — end of the time range (exclusive). Refer to the **Date rules** section.\n- **`limit`** *(optional)* — maximum number of records per page. Defaults to 100; values above 1000 are reduced to 1000.\n- **`cursor`** — the `nextCursor` value from the previous response. Omit on the initial call. When a cursor is sent, all other fields must be omitted.\n\n### Date rules\n\n- Accepted format: ISO 8601 with an explicit UTC offset, e.g. `2026-06-01T00:00:00Z`.\n- `activityAfter` is inclusive; `activityBefore` is exclusive.\n- `activityAfter` cannot be in the future.\n- `activityAfter` cannot be older than 1 year.\n- If `activityBefore` is in the future, it is silently clamped to `now`.\n- `activityBefore` must be after `activityAfter` (after clamping).\n- The window between `activityAfter` and `activityBefore` must not exceed 90 days.\n\n### Ordering and safe upper bound\n\nResults are returned in descending order of when they were recorded, most recent first. A 5-second lag is applied to the upper time bound so that in-flight transactions have time to commit before they are read, preventing gaps in the results.\n\n### Access\n\nTenant admins and users whose role in the project has read access to Project Resources can access this API.",
        "operationId": "searchActivityLogs",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "actorEmails": {
                    "type": "array",
                    "description": "Optional. A list of email addresses of the users whose activity is to be retrieved. Email matching is case-insensitive. Activity of deactivated users is included. If not specified or empty, activity for all users is returned.",
                    "items": {
                      "type": "string",
                      "format": "email"
                    },
                    "example": ["john.doe@company.com"]
                  },
                  "entityTypes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["ACTION", "AUTO_SCENARIO", "MANUAL_SCENARIO"]
                    },
                    "example": ["ACTION", "AUTO_SCENARIO", "MANUAL_SCENARIO"],
                    "description": "Required. A list of entity types used to filter the results. Valid values: ACTION | AUTO_SCENARIO | MANUAL_SCENARIO."
                  },
                  "activityTypes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["CREATE", "UPDATE", "DELETE"]
                    },
                    "example": ["CREATE", "UPDATE", "DELETE"],
                    "description": "Required. A list of activity types used to filter the results. Valid values: CREATE | UPDATE | DELETE. Check-in, check-out and changes to parts of an entity are reported as UPDATE."
                  },
                  "activityAfter": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Required. The start of the time range, in ISO 8601 format with a UTC offset. The start time is inclusive, cannot be in the future and cannot be older than 1 year.",
                    "example": "2026-01-01T00:00:00Z"
                  },
                  "activityBefore": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Required. The end of the time range, in ISO 8601 format with a UTC offset. The end time is exclusive and must be after activityAfter. An end time in the future is treated as the current time. The time range cannot exceed 90 days.",
                    "example": "2026-01-31T00:00:00Z"
                  },
                  "limit": {
                    "type": "integer",
                    "description": "Optional. The maximum number of records returned in a single response. Default: 100. Maximum: 1000.",
                    "default": 100,
                    "minimum": 1,
                    "maximum": 1000,
                    "example": 100
                  },
                  "cursor": {
                    "type": "string",
                    "nullable": true,
                    "description": "The pagination token returned in the nextCursor field of the previous response. Omit on the initial call. When a cursor is specified, no other request parameters can be specified; the filters from the first request are applied. To change the filters, make a new initial call without a cursor. The cursor is an opaque value and must not be modified.",
                    "example": null
                  }
                },
                "required": ["activityAfter", "activityBefore", "entityTypes", "activityTypes"]
              },
              "examples": {
                "firstCall": {
                  "summary": "First call - with filters",
                  "value": {
                    "actorEmails": ["john.doe@company.com"],
                    "entityTypes": ["ACTION", "AUTO_SCENARIO", "MANUAL_SCENARIO"],
                    "activityTypes": ["CREATE", "UPDATE", "DELETE"],
                    "activityAfter": "2026-09-01T00:00:00Z",
                    "activityBefore": "2026-09-30T00:00:00Z",
                    "limit": 100
                  }
                },
                "nextPage": {
                  "summary": "Next page - cursor only",
                  "value": {
                    "cursor": "eyJ2IjoxLCJwaiI6MTIsImxhc3RJZCI6NTgyMTR9.b3Jr8Yq1Zx"
                  }
                },
                "singleDay": {
                  "summary": "Single day (29 Sep 2026, IST)",
                  "value": {
                    "entityTypes": ["ACTION", "AUTO_SCENARIO", "MANUAL_SCENARIO"],
                    "activityTypes": ["CREATE", "UPDATE", "DELETE"],
                    "activityAfter": "2026-09-29T00:00:00+05:30",
                    "activityBefore": "2026-09-30T00:00:00+05:30"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns a page of activity records.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "description": "The list of activity records, sorted from newest to oldest.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "actorEmail": {
                            "type": "string",
                            "format": "email",
                            "description": "The email address of the user who performed the activity.",
                            "example": "jane.smith@company.com"
                          },
                          "activityTime": {
                            "type": "string",
                            "format": "date-time",
                            "description": "The date and time when the activity occurred, in ISO 8601 format (UTC).",
                            "example": "2026-09-29T11:52:39Z"
                          },
                          "activityType": {
                            "type": "string",
                            "enum": ["CREATE", "UPDATE", "DELETE"],
                            "example": "DELETE",
                            "description": "The type of activity. Valid values: CREATE | UPDATE | DELETE."
                          },
                          "activityDescription": {
                            "type": "string",
                            "description": "A description of the change.",
                            "example": "Input Parameter username created"
                          },
                          "entityType": {
                            "type": "string",
                            "enum": ["ACTION", "AUTO_SCENARIO", "MANUAL_SCENARIO"],
                            "example": "AUTO_SCENARIO",
                            "description": "The type of entity on which the activity was performed. Valid values: ACTION | AUTO_SCENARIO | MANUAL_SCENARIO."
                          },
                          "entityId": {
                            "type": "integer",
                            "description": "The unique identifier of the Action or Scenario. The identifier stays the same across versions of the entity and is retained after the entity is deleted.",
                            "example": 20871
                          },
                          "entityName": {
                            "type": "string",
                            "description": "The name of the Action or Scenario at the time of the activity.",
                            "example": "Fund Transfer - Negative"
                          }
                        }
                      }
                    },
                    "nextCursor": {
                      "type": "string",
                      "description": "The pagination token for the next page of results. Pass this value as the cursor in the next request to retrieve the next page. Always returned, even when data is empty.",
                      "example": "eyJ2IjoxLCJwaiI6MTIsImxhc3RJZCI6NTgyMTR9.b3Jr8Yq1Zx"
                    },
                    "hasMore": {
                      "type": "boolean",
                      "description": "Indicates whether more records are available. If true, more records can be retrieved using nextCursor. If false, all matching records have been returned.",
                      "example": true
                    }
                  }
                },
                "examples": {
                  "pageWithMore": {
                    "summary": "Page with more records available",
                    "value": {
                      "data": [
                        {
                          "actorEmail": "jane.smith@company.com",
                          "activityTime": "2026-09-29T11:52:39Z",
                          "activityType": "DELETE",
                          "activityDescription": "Deleted",
                          "entityType": "AUTO_SCENARIO",
                          "entityId": 20871,
                          "entityName": "Fund Transfer - Negative"
                        },
                        {
